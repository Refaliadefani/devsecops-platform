// ==============================================================================
// Jenkinsfile.rollback - Production Rollback Pipeline
// ==============================================================================
// Pipeline untuk rollback deployment menggunakan pendekatan GitOps.
// Rollback dilakukan dengan me-revert commit terakhir di GitOps repo,
// sehingga ArgoCD otomatis sync ke state sebelumnya.
//
// Cara pakai:
//   1. Buat Jenkins job baru (Pipeline) — trigger manual
//   2. Input: APP_NAME, ENVIRONMENT, jumlah commit yang di-revert
//   3. Pipeline akan revert commit di gitops-config repo
//   4. ArgoCD detect perubahan → auto-sync (DEV) / manual sync (PROD)
//
// Credentials:
//   - git-credentials (Username/Password — Git PAT untuk GitOps repo)
// ==============================================================================

pipeline {
    agent any

    parameters {
        string(name: 'APP_NAME', description: 'Nama aplikasi yang akan di-rollback')
        choice(name: 'ENVIRONMENT', choices: ['dev', 'prod'], description: 'Environment target')
        string(name: 'COMMITS_BACK', defaultValue: '1', description: 'Jumlah commit yang di-revert (default: 1 = rollback ke versi sebelumnya)')
    }

    environment {
        GITOPS_REPO = "git.company.internal/platform/gitops-config.git"
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Confirm Rollback') {
            steps {
                script {
                    def target = "${params.APP_NAME}-${params.ENVIRONMENT}"
                    input(
                        message: "Confirm ROLLBACK ${target} by ${params.COMMITS_BACK} commit(s)?",
                        ok: 'Execute Rollback'
                    )
                }
            }
        }

        stage('Rollback via Git Revert') {
            steps {
                script {
                    echo "=== Rolling back ${params.APP_NAME}-${params.ENVIRONMENT} ==="

                    withCredentials([usernamePassword(
                        credentialsId: 'git-credentials',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS'
                    )]) {
                        sh """
                            rm -rf /tmp/gitops-rollback
                            git clone https://\${GIT_USER}:\${GIT_PASS}@\${GITOPS_REPO} /tmp/gitops-rollback
                            cd /tmp/gitops-rollback

                            echo "=== Current state (last 5 commits) ==="
                            git log --oneline -5 -- apps/${params.APP_NAME}-${params.ENVIRONMENT}/

                            echo "=== Reverting last ${params.COMMITS_BACK} commit(s) ==="
                            # Find commits that affected this app's values
                            COMMITS_TO_REVERT=\$(git log --oneline -${params.COMMITS_BACK} --format="%H" -- apps/${params.APP_NAME}-${params.ENVIRONMENT}/values.yaml)

                            for COMMIT in \$COMMITS_TO_REVERT; do
                                git revert --no-commit \$COMMIT
                            done

                            git config user.email "jenkins@ci.local"
                            git config user.name "Jenkins CI"
                            git commit -m "rollback(${params.ENVIRONMENT}): revert ${params.APP_NAME} by ${params.COMMITS_BACK} version(s) [manual]"

                            echo "=== New state ==="
                            grep "tag:" apps/${params.APP_NAME}-${params.ENVIRONMENT}/values.yaml

                            git push
                            rm -rf /tmp/gitops-rollback
                        """
                    }

                    echo "=== GitOps rollback commit pushed ==="
                    if (params.ENVIRONMENT == 'dev') {
                        echo "ArgoCD will auto-sync DEV in ~3 minutes"
                    } else {
                        echo "PROD requires manual sync — go to ArgoCD UI to apply"
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                script {
                    echo "=== Verifying rollback ==="
                    def domain = env.DOMAIN ?: 'company.internal'
                    def subdomain = params.ENVIRONMENT == 'prod' ? params.APP_NAME : "${params.APP_NAME}-${params.ENVIRONMENT}"
                    def healthUrl = "https://${subdomain}.${domain}/health"

                    echo "Waiting for deployment to stabilize..."
                    sleep(60)

                    def healthy = false
                    for (int i = 1; i <= 10; i++) {
                        def status = sh(
                            script: "curl -s -o /dev/null -w '%{http_code}' --max-time 10 --insecure ${healthUrl}",
                            returnStdout: true
                        ).trim()

                        if (status == '200') {
                            echo "Rollback verified — application healthy (attempt ${i})"
                            healthy = true
                            break
                        }

                        echo "Attempt ${i}/10 — HTTP ${status}, retrying..."
                        sleep(15)
                    }

                    if (!healthy) {
                        error "Post-rollback health check FAILED — manual intervention required"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Rollback ${params.APP_NAME}-${params.ENVIRONMENT} SUCCESS"
        }
        failure {
            echo "Rollback ${params.APP_NAME}-${params.ENVIRONMENT} FAILED — check ArgoCD UI"
        }
    }
}
